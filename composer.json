{
    "name": "vanilo/properties",
    "description": "Vanilo Properties (Attributes) Module",
    "type": "library",
    "license": "MIT",
    "keywords": ["product", "ecommerce", "vanilo", "artkonekt", "laravel"],
    "support": {
        "source": "https://github.com/vanilophp/properties"
    },
    "authors": [
        {
            "name": "Attila Fulop",
            "homepage": "https://github.com/fulopattila122"
        }
    ],
    "require": {
        "php": "^8.0|^8.2|^8.4",
        "konekt/concord": "^1.14|^1.16",
        "laravel/framework": "^9.2|^10.0|^11.0|^12.0",
        "cviebrock/eloquent-sluggable": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
    	"phpunit/phpunit": "~8.0|~9.0|~10.0",
        "orchestra/testbench": "~4.0|~5.0|~6.0",
        "laravel/legacy-factories": "^1.0.4"
    },
    "autoload": {
        "psr-4": { "Vanilo\\Properties\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Vanilo\\Properties\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.2.x-dev"
        }
    }
}
